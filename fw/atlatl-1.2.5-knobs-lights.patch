diff --git a/firmware/src/fm1bs_panel.c b/firmware/src/fm1bs_panel.c
new file mode 100644
index 0000000..cb1b06a
--- /dev/null
+++ b/firmware/src/fm1bs_panel.c
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Patrick F. Kellogg
+ *
+ * FM-1 Big Screen's panel: Big Knobs, Key Lights and the remote presses, beside the screen mirror (screen_mirror.c),
+ * by aikellogg.com/#/make-big-screen. It needs from the firmware: fm1_ms, fm1_in / fm1__lock / FM1_NENC (the knobs),
+ * fm1_led / FM1_KEYMAP / FM1_NCOL (the lights), FM1BS_SEND(m, n) (one SysEx message out, 0 = sent, never waiting),
+ * FM1BS_LISTENING (an app is asking), and, for the presses, fm1bs_held_raw[] ORed into the key scan (fm1__keys).
+ *
+ * Big Knobs (host -> FM-1): F0 7D 'F' 'S' 04 e n F7 turns encoder e (0 SELECT, 1 ALGORITHM, 2..5 KNOB 1..4, 6 PRESETS)
+ *   n clicks (7-bit signed), as if turned by hand; F0 7D 'F' 'S' 06 lo hi F7 sets MASTER (0..1023) until the real knob moves.
+ * Remote panel (host -> FM-1): F0 7D 'F' 'S' 07 id down F7 presses or lets go of button or key id (FM1_KEYMAP's ids),
+ *   into the scan before its debounce; everything let go when the app stops asking.
+ * Key Lights (FM-1 -> host): F0 7D 'F' 'S' 05 k0 k1 k2 k3 b0 b1 [g0 g1 g2 g3 h0 h1] F7: the lit keys and buttons,
+ *   then the glowing ones (FM1BS_GLOW), when they change (at most every 20 ms) and once a second.
+ */
+#ifndef FM1BS_LISTENING
+#define FM1BS_LISTENING sm_on()
+#endif
+#ifndef FM1BS_MASTER
+#define FM1BS_MASTER 0
+#endif
+
+/* ---- Big Knobs: clicks from the app, added to the encoders' own count in the main loop (as the scan would) */
+static volatile int8_t fm1bs_turns[8];
+/* 1 when it was a Big Knobs / remote press message (taken); 0 for anything else */
+static int fm1bs_panel_sysex(const uint8_t *m, unsigned n)
+{
+    if (n == 8u && m[4] == 4u && m[7] == 0xF7u) {
+        int32_t d = m[6] & 127u;
+        if (d >= 64)
+            d -= 128;
+        if (m[5] < 8u)
+            fm1bs_turns[m[5]] = (int8_t)(fm1bs_turns[m[5]] + d);
+        return 1;
+    }
+#if FM1BS_MASTER
+    if (n == 8u && m[4] == 6u && m[7] == 0xF7u) {
+        fm1bs_master = (int32_t)(m[5] & 127u) | (int32_t)(m[6] & 127u) << 7;
+        if (fm1bs_master > 1023)
+            fm1bs_master = 1023;
+        fm1bs_master_pot = -1;                       /* the real knob's place now: moving it takes over again */
+        return 1;
+    }
+#endif
+#ifdef FM1BS_HELD
+    if (n == 8u && m[4] == 7u && m[7] == 0xF7u) {
+        uint32_t c, r;
+        for (c = 0; c < FM1_NCOL; c++)
+            for (r = 1; r < 5u; r++)
+                if (m[5] < 41u && FM1_KEYMAP[r][c] == (int8_t)m[5]) {
+                    if (m[6])
+                        fm1bs_held_raw[c] = (uint8_t)(fm1bs_held_raw[c] | 1u << r);
+                    else
+                        fm1bs_held_raw[c] = (uint8_t)(fm1bs_held_raw[c] & ~(1u << r));
+                }
+        return 1;
+    }
+#endif
+    return 0;
+}
+
+static void fm1bs_knobs(void)
+{
+#ifdef FM1_NENC
+    uint32_t e;
+    for (e = 0; e < FM1_NENC && e < 8u; e++)
+        if (fm1bs_turns[e]) {
+            uint32_t k = fm1__lock();
+            int32_t d = fm1bs_turns[e];
+            fm1bs_turns[e] = 0;
+            fm1_in.enc_steps[e] = (int16_t)(fm1_in.enc_steps[e] + d);
+            fm1__unlock(k);
+        }
+#endif
+}
+
+/* ---- Key Lights: the lit LEDs to the app (fm1_led: a packed row byte per column; FM1_KEYMAP: ids) */
+static void fm1bs_lights(void)
+{
+#if defined(FM1_NCOL) && defined(FM1_NKEY)
+    static uint32_t sent_at, last_k = 0xFFFFFFFFu, last_b = 0xFFFFFFFFu, last_gk, last_gb;
+    uint32_t c, r, keys = 0, btns = 0, gk = 0, gb = 0, n = 12u;
+    uint8_t m[18];
+    if (!FM1BS_LISTENING || fm1_ms - sent_at < 20u)
+        return;
+    for (c = 0; c < FM1_NCOL; c++)
+        for (r = 1; r < 5u; r++) {
+            int32_t id = FM1_KEYMAP[r][c];
+            uint32_t lit = (fm1_led[c] >> r) & 1u, glow = 0;
+#ifdef FM1BS_GLOW
+            glow = !lit && ((FM1BS_GLOW(c)) >> r & 1u);
+#endif
+            if (id < 0 || !(lit | glow))
+                continue;
+            if (id < 14) {
+                if (lit) btns |= 1u << id; else gb |= 1u << id;
+            } else if (id < 41) {
+                if (lit) keys |= 1u << (id - 14); else gk |= 1u << (id - 14);
+            }
+        }
+    if (keys == last_k && btns == last_b && gk == last_gk && gb == last_gb && fm1_ms - sent_at < 1000u)
+        return;
+    m[0] = 0xF0; m[1] = 0x7D; m[2] = 'F'; m[3] = 'S'; m[4] = 5;
+    m[5] = keys & 127u; m[6] = keys >> 7 & 127u; m[7] = keys >> 14 & 127u; m[8] = keys >> 21 & 127u;
+    m[9] = btns & 127u; m[10] = btns >> 7 & 127u; m[11] = 0xF7;
+#ifdef FM1BS_GLOW
+    m[11] = gk & 127u; m[12] = gk >> 7 & 127u; m[13] = gk >> 14 & 127u; m[14] = gk >> 21 & 127u;
+    m[15] = gb & 127u; m[16] = gb >> 7 & 127u; m[17] = 0xF7;
+    n = 18u;
+#endif
+    if (FM1BS_SEND(m, n) == 0) {
+        last_k = keys;
+        last_b = btns;
+        last_gk = gk;
+        last_gb = gb;
+        sent_at = fm1_ms;
+    }
+#endif
+}
+
+
+/* every main-loop pass: the knobs' clicks in, the lights out, the presses let go when the app has gone */
+static void fm1bs_panel_service(void)
+{
+    fm1bs_knobs();
+    fm1bs_lights();
+#ifdef FM1BS_HELD
+    if (!sm_on()) {
+        uint32_t c;
+        for (c = 0; c < FM1_NCOL; c++)
+            fm1bs_held_raw[c] = 0;
+    }
+#endif
+}
