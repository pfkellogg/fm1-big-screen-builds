new file mode 100644
index 0000000..b4b61f1
--- /dev/null
+++ b/firmware/src/fm1bs_mirror.c
@@ -0,0 +1,191 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Patrick F. Kellogg
+ *
+ * FM-1 Big Screen, added to a Felucca-family firmware by aikellogg.com/#/make-big-screen (unofficial build).
+ * While an app asks (F0 7D 'F' 'S' 00/01 F7, about once a second), every rectangle sent to the LCD (lcd.c) also goes
+ * out over USB MIDI SysEx, so FM-1 Big Screen (github.com/pfkellogg/fm1-mirror) shows the screen big. screen_mirror.c
+ * makes the messages; this is the glue: the hello from usb.c sysex_byte, sending through usb.c's SysEx ring without
+ * ever waiting on it, and the main loop's poll. The firmware's name goes out as the sound's name. With nobody asking it
+ * does nothing. USB only.
+ *
+ * Big Knobs (host -> FM-1): F0 7D 'F' 'S' 04 e n F7 turns encoder e (0 SELECT, 1 ALGORITHM, 2..5 KNOB 1..4, 6 PRESETS)
+ *   n clicks (7-bit signed: 1..63 clockwise, 127..65 = -1..-63), as if turned by hand;
+ *   F0 7D 'F' 'S' 06 lo hi F7 sets MASTER (0..1023, lo + hi * 128) until the real knob moves.
+ * Remote panel (host -> FM-1): F0 7D 'F' 'S' 07 id down F7 presses (down 1) or lets go (0) button or key id (0..13 the
+ *   buttons, 14..40 the keys F3..G5: FM1_KEYMAP's ids), as a finger would: into the scan before its debounce, so holds
+ *   and combinations work. Everything held is let go when the app stops asking.
+ * Key Lights (FM-1 -> host): F0 7D 'F' 'S' 05 k0 k1 k2 k3 b0 b1 [g0 g1 g2 g3 h0 h1] F7, while an app asks: the lit
+ *   LEDs, keys (bit k = key k, F3 .. G5, 7 bits a byte, k0 first) and buttons (bit i = button id i, 0..13); then, where
+ *   the firmware has them (FM1BS_GLOW), the softer glows the same way (dim, breathing, mid-level LEDs that aren't fully
+ *   lit). When they change, at most every 20 ms, and once a second.
+ */
+#ifndef FM1BS_BUFFER
+#define FM1BS_BUFFER 6144u
+#endif
+#define SM_BUFFER FM1BS_BUFFER
+#include "screen_mirror.c"
+
+static uint16_t mirror_row[240];                 /* one row, back in RGB565 order (the LCD's buffers are byte-swapped) */
+static uint8_t mirror_lost;                      /* rows dropped: the whole screen again when there's room */
+static uint32_t mirror_full_at;                  /* the last whole-screen redraw asked for (at most twice a second) */
+
+/* One SysEx message into usb.c's ring, or -2 (busy) when it has no room for all of it: never waits */
+static int mirror_send(const uint8_t *m, unsigned n)
+{
+    if (!usb.config)
+        return -1;
+    if (SXQ - (so_w - so_r) < (n + 2u) / 3u + 1u)
+        return -2;
+    return ota_wire_send(m, n) ? -1 : 0;
+}
+
+/* lcd.c: a rectangle about to go to the LCD; px (byte-swapped, stride pixels a row) or, for a fill, NULL and the
+ * colour c */
+static void mirror_lcd(uint32_t x, uint32_t y, uint32_t w, uint32_t h, const uint16_t *px, uint32_t stride, uint16_t c)
+{
+    uint32_t r, i, start = fm1_ms;
+    if (!sm_on() || mirror_lost || x >= 240u || y >= 240u)
+        return;
+    if (x + w > 240u)
+        w = 240u - x;
+    if (y + h > 240u)
+        h = 240u - y;
+    for (r = 0; r < h; r++) {
+        uint32_t t0 = fm1_ms;
+        if (fm1_ms - start > 400u) {                   /* the host isn't keeping up: never hold the screen longer */
+            mirror_lost = 1;
+            return;
+        }
+        for (i = 0; i < w; i++)
+            mirror_row[i] = px ? (uint16_t)((px[r * stride + i] >> 8) | (px[r * stride + i] << 8)) : c;
+        while (!sm_rows(mirror_row, x, y + r, w, 1)) {   /* full: send some, briefly; else the whole screen later */
+            sm_poll(fm1_ms, mirror_send);
+            if (fm1_ms - t0 > 60u) {
+                mirror_lost = 1;
+                return;
+            }
+        }
+    }
+}
+
+/* ---- Big Knobs: clicks from the app, added to the encoders' own count in the main loop (as the scan would) */
+static volatile int8_t fm1bs_turns[8];
+int fm1bs_sysex(const uint8_t *m, unsigned n)
+{
+    if (n == 8u && m[4] == 4u && m[7] == 0xF7u) {
+        int32_t d = m[6] & 127u;
+        if (d >= 64)
+            d -= 128;
+        if (m[5] < 8u)
+            fm1bs_turns[m[5]] = (int8_t)(fm1bs_turns[m[5]] + d);
+        return 1;
+    }
+#if FM1BS_MASTER
+    if (n == 8u && m[4] == 6u && m[7] == 0xF7u) {
+        fm1bs_master = (int32_t)(m[5] & 127u) | (int32_t)(m[6] & 127u) << 7;
+        if (fm1bs_master > 1023)
+            fm1bs_master = 1023;
+        fm1bs_master_pot = -1;                       /* the real knob's place now: moving it takes over again */
+        return 1;
+    }
+#endif
+#ifdef FM1BS_HELD
+    if (n == 8u && m[4] == 7u && m[7] == 0xF7u) {
+        uint32_t c, r;
+        for (c = 0; c < FM1_NCOL; c++)
+            for (r = 1; r < 5u; r++)
+                if (m[5] < 41u && FM1_KEYMAP[r][c] == (int8_t)m[5]) {
+                    if (m[6])
+                        fm1bs_held_raw[c] = (uint8_t)(fm1bs_held_raw[c] | 1u << r);
+                    else
+                        fm1bs_held_raw[c] = (uint8_t)(fm1bs_held_raw[c] & ~(1u << r));
+                }
+        return 1;
+    }
+#endif
+    return sm_sysex(m, n);
+}
+
+static void fm1bs_knobs(void)
+{
+#ifdef FM1_NENC
+    uint32_t e;
+    for (e = 0; e < FM1_NENC && e < 8u; e++)
+        if (fm1bs_turns[e]) {
+            uint32_t k = fm1__lock();
+            int32_t d = fm1bs_turns[e];
+            fm1bs_turns[e] = 0;
+            fm1_in.enc_steps[e] = (int16_t)(fm1_in.enc_steps[e] + d);
+            fm1__unlock(k);
+        }
+#endif
+}
+
+/* ---- Key Lights: the lit LEDs to the app (fm1_led: a packed row byte per column; FM1_KEYMAP: ids) */
+static void fm1bs_lights(void)
+{
+#if defined(FM1_NCOL) && defined(FM1_NKEY)
+    static uint32_t sent_at, last_k = 0xFFFFFFFFu, last_b = 0xFFFFFFFFu, last_gk, last_gb;
+    uint32_t c, r, keys = 0, btns = 0, gk = 0, gb = 0, n = 12u;
+    uint8_t m[18];
+    if (!sm_name_live || fm1_ms - sent_at < 20u)
+        return;
+    for (c = 0; c < FM1_NCOL; c++)
+        for (r = 1; r < 5u; r++) {
+            int32_t id = FM1_KEYMAP[r][c];
+            uint32_t lit = (fm1_led[c] >> r) & 1u, glow = 0;
+#ifdef FM1BS_GLOW
+            glow = !lit && ((FM1BS_GLOW(c)) >> r & 1u);
+#endif
+            if (id < 0 || !(lit | glow))
+                continue;
+            if (id < 14) {
+                if (lit) btns |= 1u << id; else gb |= 1u << id;
+            } else if (id < 41) {
+                if (lit) keys |= 1u << (id - 14); else gk |= 1u << (id - 14);
+            }
+        }
+    if (keys == last_k && btns == last_b && gk == last_gk && gb == last_gb && fm1_ms - sent_at < 1000u)
+        return;
+    m[0] = 0xF0; m[1] = 0x7D; m[2] = 'F'; m[3] = 'S'; m[4] = 5;
+    m[5] = keys & 127u; m[6] = keys >> 7 & 127u; m[7] = keys >> 14 & 127u; m[8] = keys >> 21 & 127u;
+    m[9] = btns & 127u; m[10] = btns >> 7 & 127u; m[11] = 0xF7;
+#ifdef FM1BS_GLOW
+    m[11] = gk & 127u; m[12] = gk >> 7 & 127u; m[13] = gk >> 14 & 127u; m[14] = gk >> 21 & 127u;
+    m[15] = gb & 127u; m[16] = gb >> 7 & 127u; m[17] = 0xF7;
+    n = 18u;
+#endif
+    if (mirror_send(m, n) == 0) {
+        last_k = keys;
+        last_b = btns;
+        last_gk = gk;
+        last_gb = gb;
+        sent_at = fm1_ms;
+    }
+#endif
+}
+
+/* main loop: send what's queued; a new viewer (or rows dropped) gets the whole screen redrawn */
+static void mirror_service(void)
+{
+    static uint32_t named_at;
+    sm_poll(fm1_ms, mirror_send);
+    if (fm1_ms - named_at >= 100u) {
+        named_at = fm1_ms;
+        sm_name(FM1BS_NAME, fm1_ms, mirror_send);
+    }
+    fm1bs_knobs();
+    fm1bs_lights();
+#ifdef FM1BS_HELD
+    if (!sm_on()) {                                   /* the app went away: let go of everything it held */
+        uint32_t c;
+        for (c = 0; c < FM1_NCOL; c++)
+            fm1bs_held_raw[c] = 0;
+    }
+#endif
+    if (sm_take_full_request() || (mirror_lost && sm_on() && fm1_ms - mirror_full_at >= 500u)) {
+        mirror_lost = 0;
+        mirror_full_at = fm1_ms;
+        FM1BS_REDRAW_ALL;
+    }
+}
diff --git a/firmware/src/screen_mirror.c b/firmware/src/screen_mirror.c
new file mode 100644
index 0000000..50efb9d
--- /dev/null
+++ b/firmware/src/screen_mirror.c
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Patrick F. Kellogg
+ *
+ * FM-1 screen mirror, firmware-neutral version of the "Screen mirror" section
+ * in app/screen.c of the screen-out branch. Messages (see README.md):
+ *   in:  F0 7D 'F' 'S' 00 F7  (01: and send the whole screen again; 02: only the sound's name, no screen)
+ *   out: F0 7D 'F' 'S' 01 row_lo row_hi col_lo col_hi {count c0-6 c7-13 c14-15}... F7
+ *        F0 7D 'F' 'S' 02 name... F7  (the sound playing, in ASCII: sm_name; after each hello and when it changes)
+ * Each message is at most SM_MESSAGE bytes, so it shares a small USB queue with notes.
+ */
+#include "screen_mirror.h"
+
+#ifndef SM_BUFFER
+#define SM_BUFFER 16384u /* queued messages, each with a length byte in front */
+#endif
+#define SM_MESSAGE 70u
+#define SM_TIMEOUT 3000u
+
+/* (sm_ prefixed: a firmware built as one compilation unit, like ChoralRoot, may have its own "buffer", "length"...) */
+static uint8_t sm_buffer[SM_BUFFER];
+static unsigned sm_length, sm_sent, sm_live, sm_hello, sm_full;
+static uint32_t sm_heard;
+static unsigned sm_name_hello, sm_name_live, sm_name_due;
+static uint32_t sm_name_heard;
+static char sm_name_last[48];
+
+int sm_sysex(const uint8_t *m, unsigned n)
+{
+    if (n != 6 || m[0] != 0xf0 || m[1] != 0x7d || m[2] != 'F' || m[3] != 'S' || m[5] != 0xf7)
+        return 0;
+    sm_name_hello = 1;                 /* every hello also asks for the sound's name */
+    if (m[4] != 2)
+        sm_hello = 1u + (m[4] == 1);
+    return 1;
+}
+
+int sm_on(void) { return sm_live || sm_hello; }
+
+int sm_take_full_request(void)
+{
+    unsigned f = sm_full;
+    sm_full = 0;
+    return (int)f;
+}
+
+int sm_rows(const uint16_t *px, unsigned left, unsigned top, unsigned width, unsigned rows)
+{
+    unsigned before = sm_length;
+    for (unsigned row = 0; row < rows; ++row, px += width)
+        for (unsigned i = 0; i < width;) {
+            if (sm_length + 1u + SM_MESSAGE > SM_BUFFER) { /* room for a whole message, or wait */
+                if (!before) return 1; /* bigger than the whole buffer: sent as far as it fits */
+                sm_length = before;
+                return 0;
+            }
+            uint8_t *out = sm_buffer + sm_length;
+            unsigned y = top + row, x = left + i, k = 10;
+            out[1] = 0xf0; out[2] = 0x7d; out[3] = 'F'; out[4] = 'S'; out[5] = 1;
+            out[6] = (uint8_t)(y & 127u); out[7] = (uint8_t)(y >> 7);
+            out[8] = (uint8_t)(x & 127u); out[9] = (uint8_t)(x >> 7);
+            for (; i < width && k + 5u <= SM_MESSAGE; k += 4) {
+                unsigned run = 1, c = px[i];
+                while (i + run < width && run < 127 && px[i + run] == c) ++run;
+                out[k] = (uint8_t)run;
+                out[k + 1] = (uint8_t)(c & 127u);
+                out[k + 2] = (uint8_t)((c >> 7) & 127u);
+                out[k + 3] = (uint8_t)(c >> 14);
+                i += run;
+            }
+            out[k] = 0xf7;
+            out[0] = (uint8_t)k;
+            sm_length += 1u + k;
+        }
+    return 1;
+}
+
+void sm_poll(uint32_t now, sm_send_fn send)
+{
+    if (sm_hello) {
+        sm_heard = now;
+        if (!sm_live || sm_hello > 1) sm_full = 1;
+        sm_hello = 0;
+        sm_live = 1;
+    }
+    if (now - sm_heard >= SM_TIMEOUT) sm_live = 0;
+    while (sm_live && sm_sent < sm_length) {
+        int r = send(sm_buffer + sm_sent + 1, sm_buffer[sm_sent]);
+        if (r == -2) break; /* busy: the rest next time */
+        if (r) sm_live = 0;
+        sm_sent += 1u + sm_buffer[sm_sent];
+    }
+    if (!sm_live || sm_sent >= sm_length) {
+        sm_length = sm_sent = 0;
+    } else if (sm_sent) {
+        /* Move what's left to the front, so the room it freed takes new rows now (with a small buffer, waiting for
+         * all of it to go first held the screen up too long). Forward copy: the data only moves down. */
+        unsigned i, n = sm_length - sm_sent;
+        for (i = 0; i < n; i++)
+            sm_buffer[i] = sm_buffer[sm_sent + i];
+        sm_length = n;
+        sm_sent = 0;
+    }
+}
+
+void sm_name(const char *name, uint32_t now, sm_send_fn send)
+{
+    uint8_t m[6 + 48];
+    unsigned i, n = 5, same = 1;
+    if (sm_name_hello) {               /* a hello (of either kind): send the name now, and keep it fresh 3 s */
+        sm_name_hello = 0;
+        sm_name_heard = now;
+        sm_name_live = 1;
+        sm_name_due = 1;
+    }
+    if (now - sm_name_heard >= SM_TIMEOUT) sm_name_live = 0;
+    if (!sm_name_live) return;
+    for (i = 0; i < sizeof sm_name_last - 1u && name[i]; ++i)
+        if (sm_name_last[i] != name[i]) same = 0;
+    if (sm_name_last[i]) same = 0;
+    if (!same) {
+        for (i = 0; i < sizeof sm_name_last - 1u && name[i]; ++i) sm_name_last[i] = name[i];
+        sm_name_last[i] = 0;
+        sm_name_due = 1;
+    }
+    if (!sm_name_due) return;
+    m[0] = 0xf0; m[1] = 0x7d; m[2] = 'F'; m[3] = 'S'; m[4] = 2;
+    for (i = 0; sm_name_last[i]; ++i) {
+        uint8_t c = (uint8_t)sm_name_last[i];
+        m[n++] = c < 0x20 || c > 0x7e ? (uint8_t)' ' : c;   /* 7-bit only (the header's middle dot: a space) */
+    }
+    m[n++] = 0xf7;
+    i = (unsigned)send(m, n);
+    if ((int)i == 0) sm_name_due = 0;  /* busy (-2) or not sent: again next time */
+}
diff --git a/firmware/src/screen_mirror.h b/firmware/src/screen_mirror.h
new file mode 100644
index 0000000..06d9113
--- /dev/null
+++ b/firmware/src/screen_mirror.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Patrick F. Kellogg
+ *
+ * FM-1 screen mirror: sends the screen over USB MIDI SysEx to FM-1 Mirror
+ * (github.com/pfkellogg/fm1-mirror) or any app that speaks the same messages.
+ * Firmware-neutral: it needs only the rows you send to the LCD, a millisecond
+ * clock and a way to send one SysEx message. See README.md.
+ */
+#ifndef SCREEN_MIRROR_H
+#define SCREEN_MIRROR_H
+#include <stdint.h>
+
+/* Sends one complete SysEx message (F0 ... F7). Return 0 when sent, -2 when
+ * the output is busy (try the same message again later), anything else to
+ * stop mirroring. */
+typedef int (*sm_send_fn)(const uint8_t *message, unsigned length);
+
+/* Call for every incoming SysEx message; returns 1 if it was a mirror hello
+ * (F0 7D 'F' 'S' 00/01/02 F7; 02 asks only for the sound's name), which the caller can then ignore. */
+int sm_sysex(const uint8_t *m, unsigned n);
+
+/* 1 while an app is asking: only then is sm_rows worth calling. */
+int sm_on(void);
+
+/* 1 once when the app wants the whole screen (a new viewer): repaint everything. */
+int sm_take_full_request(void);
+
+/* Queue `rows` rows of RGB565 pixels, `width` wide, whose top-left is (left, top).
+ * Returns 0 when the buffer has no room yet: call again with the same rows after
+ * sm_poll has sent some (or skip, and repaint those rows later). */
