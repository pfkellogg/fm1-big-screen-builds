diff --git a/app/app.c b/app/app.c
index ffe0b32..ffa2780 100644
--- a/app/app.c
+++ b/app/app.c
@@ -957,3 +957,39 @@ void app_say(const char *a, const char *b)
     if (ann_on())
         ann_say(a, b, ANN_NOW | ANN_KEEP);
 }
+
+/* FM-1 Big Screen (unofficial build, aikellogg.com): a row of what the panel shows, for the mirror's repair */
+const uint16_t *app_mirror_row(uint32_t y)
+{
+    static uint16_t row[H1_W];
+    const uint8_t *s = h1_panel() + y * H1_W;
+    for (int i = 0; i < H1_W; i++)
+        row[i] = pal_be[s[i]];
+    return row;
+}
+
+/* FM-1 Big Screen: the mirror's counters in the development readout (F0 7D 4C 47 F7) */
+void fm1bs_mr_counts(uint32_t *o);
+void app_log(void (*line)(const char *t))
+{
+    static const char *const N[9] = {"bytes", "rects", "rows", "drops", "skipped", "redraws", "px", "waits", "timeouts"};
+    uint32_t o[9];
+    char b[40];
+    fm1bs_mr_counts(o);
+    for (int k = 0; k < 9; k++) {
+        char *q = b;
+        const char *s = N[k];
+        uint32_t v = o[k];
+        char d[12];
+        int n = 0;
+        *q++ = 'm'; *q++ = 'r'; *q++ = ' ';
+        while (*s)
+            *q++ = *s++;
+        *q++ = ' ';
+        do { d[n++] = (char)('0' + v % 10u); v /= 10u; } while (v);
+        while (n)
+            *q++ = d[--n];
+        *q = 0;
+        line(b);
+    }
+}
